{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--prefix",
        "backend"
      ],
      "port": 3000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 5173
    },
    {
      "name": "local-backend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        ".claude/local-stack.mjs",
        "backend"
      ],
      "port": 3100
    },
    {
      "name": "local-frontend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        ".claude/local-stack.mjs",
        "frontend"
      ],
      "port": 5174
    },
    {
      "name": "qa-backend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/qa/stack.mjs", "backend"],
      "port": 3200
    },
    {
      "name": "qa-backend-nojudge",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/qa/stack.mjs", "backend-nojudge"],
      "port": 3201
    },
    {
      "name": "qa-frontend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/qa/stack.mjs", "frontend"],
      "port": 5175
    },
    {
      "name": "qa-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/qa/stack.mjs", "preview"],
      "port": 5175
    }
  ]
}
