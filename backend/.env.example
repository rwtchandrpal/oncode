# Copy to backend/.env and fill in. Names only: never commit real values.
# Use LOCAL/DEV services here (see "Local development" in the README); production values belong
# in the backend host's secret store, not on a laptop.
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/oncode_dev
# 64 random hex chars, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_KEY=change-me-64-hex-chars
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=
JUDGE0_BASE_URL=https://judge0.example.internal
JUDGE0_AUTH_TOKEN=
# Optional; default 10000
JUDGE0_TIMEOUT_MS=10000
GEMINI_API_KEY=
CLIENT_URL=http://localhost:5173
