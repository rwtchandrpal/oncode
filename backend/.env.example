# Copy to backend/.env and fill in. Names only: never commit real values.
# Use LOCAL/DEV services here (see "Local development" in the README); production values belong
# in the backend host's secret store, not on a laptop.
# development | production | test (default development). Set production on the server.
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/oncode_dev
# 64 random hex chars, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_KEY=change-me-64-hex-chars
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=
JUDGE0_BASE_URL=https://judge0.example.internal
JUDGE0_AUTH_TOKEN=
# Optional: per-request timeout (default 5000) and overall budget per execution (default 30000)
JUDGE0_TIMEOUT_MS=5000
JUDGE0_DEADLINE_MS=30000
GEMINI_API_KEY=
CLIENT_URL=http://localhost:5173
# Optional: reverse-proxy hops in front of the API (express "trust proxy"). 0 = trust none (default).
# Must match the real host (e.g. 1 behind a single load balancer); a wrong value lets clients spoof IPs.
TRUST_PROXY_HOPS=0
# Optional: fatal|error|warn|info|debug|trace|silent (default info)
LOG_LEVEL=info
# Optional: guest mode (one-click sessions without an account). false turns it off. Default true.
GUEST_MODE_ENABLED=true
