# Copy to backend/.env and fill in. Placeholders only: never commit real values.
# The API validates these on startup and exits with the names of any missing or invalid variables.

# --- Server ---
# development | production | test (default development)
NODE_ENV=development
PORT=3000
# Frontend origin allowed by CORS (the Vite dev server locally, your Vercel URL in production)
CLIENT_URL=http://localhost:5173
# Optional: reverse-proxy hops in front of the API (express "trust proxy"). 0 = trust none (default).
# Must match the real host (e.g. 1 behind one load balancer); a wrong value lets clients spoof IPs.
TRUST_PROXY_HOPS=0
# Optional: fatal | error | warn | info | debug | trace | silent (default info)
LOG_LEVEL=info

# --- MongoDB (required) ---
# A replica set (Atlas, or a local single-node one) enables transactions; a standalone server also works.
MONGO_URI=mongodb://127.0.0.1:27017/oncode

# --- Auth (required) ---
# Long random secret for signing JWTs, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_KEY=replace-with-a-long-random-secret

# --- Redis (required): logout blocklist, rate limits, guest quotas, topic cache ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=

# --- Judge0 (required): code execution for Run / Submit and for validating new problems ---
JUDGE0_BASE_URL=http://localhost:2358
# Sent as the X-Auth-Token header; leave empty if your Judge0 has no AUTHN_TOKEN set
JUDGE0_AUTH_TOKEN=
# Optional: per-request timeout (default 5000) and overall budget per execution (default 30000), in ms
JUDGE0_TIMEOUT_MS=5000
JUDGE0_DEADLINE_MS=30000

# --- AI tutor (required at startup) ---
# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# --- Guest mode ---
# Optional: one-click 4-hour sessions without an account. false turns it off. Default true.
GUEST_MODE_ENABLED=true
